{
  "name": "back",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "dev": "node --env-file=.env --watch app.js",
    "start": "node --env-file=.env app.js",

    "db:setup": "node --env-file=.env database/setup.js",
    "db:create-migration": "node-pg-migrate create --migrations-dir database/migrations",
    "db:migrate": "node --env-file=.env database/run_migrations.js up",
    "db:rollback": "node --env-file=.env database/run_migrations.js down",
    "db:seed": "node --env-file=.env database/seeds/seed.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.2",
    "connect-history-api-fallback": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "express-session": "^1.18.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0"
  }
}
